{
  "name": "easyluxtransfer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run typecheck && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "preview:cloudflare": "npm run build && wrangler dev",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.0.0",
    "@types/google.maps": "^3.66.4",
    "@vitejs/plugin-react": "5.0.4",
    "libphonenumber-js": "^1.13.14",
    "pikaicons": "^0.0.5",
    "react": "19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.0",
    "tailwindcss": "^4.0.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "wrangler": "4.143.0"
  },
  "overrides": {
    "undici": "7.29.1",
    "sharp": "0.35.5"
  }
}
